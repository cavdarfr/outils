{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outils",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "outils.cavdar.dev", "custom_domain": true }]
}
