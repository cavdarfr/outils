{
  "name": "outils",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm vendor && astro dev --port ${PORT:-4321}",
    "build": "pnpm vendor && astro build",
    "preview": "astro preview --port ${PORT:-4321}",
    "typecheck": "astro check",
    "test": "vitest run",
    "check": "astro check && vitest run && pnpm build",
    "e2e": "playwright test",
    "vendor": "node scripts/copy-vendor.mjs",
    "e2e:prod": "E2E_BASE_URL=${E2E_BASE_URL:-https://outils.cavdar.dev} playwright test --project=chromium --project=mobile-safari",
    "new-tool": "node scripts/new-tool.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.6",
    "astro": "^7.4.12",
    "fflate": "^0.8.3",
    "libheif-js": "^1.23.5",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  }
}
